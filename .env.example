# ─── Supabase Core ─────────────────────────────────────────────
# JWT Secret (must be at least 32 characters — generate with: openssl rand -base64 32)
SUPABASE_JWT_SECRET=your-super-secret-jwt-token-with-at-least-32-characters-long

# PostgreSQL Password (generate with: openssl rand -base64 24)
POSTGRES_PASSWORD=postgres

# Supabase API Keys (JWTs encoded with the JWT_SECRET above)
# For production, regenerate these with your actual JWT secret
# Generate: node -e "console.log(require('jsonwebtoken').sign({role:'anon',iss:'supabase',exp:Math.floor(Date.now()/1000)+3600*24*365*10},process.argv[1]))" YOUR_SECRET
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# ─── Next.js Apps ────────────────────────────────────────────────
# The URL that Next.js apps use to reach Supabase (internal Docker URL for self-hosted)
NEXT_PUBLIC_SUPABASE_URL=http://kong:8000

# Publishable key for Supabase Realtime
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ─── Domain Configuration ───────────────────────────────────────
# Used by Caddy and GoTrue for redirect URLs
SITE_URL=https://rokhdad.click
ADMIN_URL=https://admin.rokhdad.click
SITE_DOMAIN=rokhdad.click
ADMIN_DOMAIN=admin.rokhdad.click

# ─── Auth / SMS (Production) ────────────────────────────────────
# Disable email auto-confirm in production
MAILER_AUTOCONFIRM=false

# SMS Provider for OTP (kavenegar, messagebird, twilio, vonage)
SMS_PROVIDER=
SMS_KAVENEGAR_API_KEY=
SMS_KAVENEGAR_TEMPLATE=

# Dev OTP bypass (DO NOT set in production!)
# DEV_OTP=123456

# ─── Logging ─────────────────────────────────────────────────────
LOGFLARE_API_KEY=your-super-secret-and-long-logflare-key

# ─── Image Processing ───────────────────────────────────────────
IMGPROXY_ENABLE_WEBP_DETECTION=true

# ─── Database Migration (for scripts/execute-migrations.js) ─────
# Direct Postgres connection string (used only by migration scripts)
# DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres